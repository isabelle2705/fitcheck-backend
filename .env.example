# Required — Railway provides this automatically when you add Redis
REDIS_URL=redis://localhost:6379

# Higgsfield (get from cloud.higgsfield.ai)
HIGGSFIELD_API_KEY=

# Cloudflare R2 storage (get from dash.cloudflare.com)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fitcheck-images
R2_PUBLIC_URL=

# Anthropic (get from console.anthropic.com)
ANTHROPIC_API_KEY=

# Points config
STARTER_POINTS=100
POINTS_PER_GENERATION=10
